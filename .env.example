# Copy this file to .env (setup.sh does it for you). .env is private and is never pushed.
# One pair of lines per brand. The brand name goes in CAPITALS, dashes become underscores
# (example-brand -> EXAMPLE_BRAND, my-brand -> MY_BRAND).
# Get a token by messaging @BotFather on Telegram. Get your chat id by messaging your new bot, then opening
# https://api.telegram.org/bot<YOUR TOKEN>/getUpdates in a browser and reading "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN_EXAMPLE_BRAND=
TELEGRAM_ALLOWED_CHAT_ID_EXAMPLE_BRAND=
